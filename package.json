{
  "name": "spaceblast",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "npm run typecheck && vite build",
    "build:server": "vite build --ssr server/fly.ts --outDir dist-server",
    "preview": "vite preview --host",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.worker.json",
    "deploy": "npm run build && wrangler deploy",
    "online": "npm run build && wrangler dev",
    "deploy:fly": "fly deploy --ha=false",
    "build:portal": "node scripts/build_portal.mjs",
    "status": "node scripts/status.mjs",
    "shots": "node scripts/shots.mjs",
    "live": "node scripts/live_check.mjs",
    "check": "npm test && npm run build && node scripts/build_portal.mjs",
    "online-check": "node scripts/online_check.mjs"
  },
  "dependencies": {
    "@fontsource/chakra-petch": "^5.3.0",
    "@fontsource/russo-one": "^5.3.0",
    "three": "^0.186.1",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261016.1",
    "@types/node": "^22.20.5",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.2",
    "playwright": "^1.56.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.1"
  }
}
